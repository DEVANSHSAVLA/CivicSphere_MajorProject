# CivicSphere AI Backend Environment Configuration Template
JWT_SECRET_KEY=replace_with_strong_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie security configuration
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# Allowed origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://civicsphere-teal.vercel.app

ENVIRONMENT=development

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=civicsphere

# Google Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_CLIENT_ID=49632315444-rgquob9l21btkc2oojcim59h4sddovt1.apps.googleusercontent.com

# Cloudinary Cloud Storage Configuration (https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=
